{
  "globalStyle": {
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "饮食记录",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle",
    "backgroundColorTop": "@bgColorTop",
    "backgroundColorBottom": "@bgColorBottom",
    "enablePullDownRefresh": false,
    "onReachBottomDistance": 50,
    "animationType": "pop-in",
    "animationDuration": 300
  },
  "pages": [
    // #ifdef APP
    {
      "path": "pages/about/index",
      "type": "page",
      "name": "about",
      "layout": "tabbar",
      "style": {
        "navigationBarTitleText": "关于"
      }
    },
    // #endif
    // #ifdef H5 || MP-WEIXIN
    {
      "path": "pages/create-post/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "发布动态",
        "navigationStyle": "custom"
      }
    },
    // #endif
    {
      "path": "pages/index/index",
      "type": "home",
      "name": "home",
      "layout": "tabbar",
      "style": {
        "navigationBarTitleText": "首页",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/add-meal/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "添加餐食",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/article/index",
      "type": "page",
      "name": "article",
      "style": {
        "navigationBarTitleText": "文章详情",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/feed/index",
      "type": "page",
      "name": "feed",
      "layout": "tabbar",
      "style": {
        "navigationBarTitleText": "动态广场",
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/feed-detail/index",
      "type": "page",
      "name": "feed-detail",
      "style": {
        "navigationBarTitleText": "动态详情",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/food-selector/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "选择食物",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/goal-settings/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "目标设置",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/index",
      "type": "page",
      "name": "login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/meal-history/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "餐食记录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/nutrition-stats/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "营养统计",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/personal-info/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "个人信息",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/profile/index",
      "type": "page",
      "name": "profile",
      "layout": "tabbar",
      "style": {
        "navigationBarTitleText": "个人中心",
        "navigationStyle": "custom",
        "disableScroll": true
      }
    },
    {
      "path": "pages/theme-settings/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "主题设置",
        "navigationStyle": "custom"
      }
    }
  ],
  "subPackages": [],
  "tabBar": {
    "custom": true,
    "customize": true,
    "overlay": true,
    "height": "0",
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      // GENERATED BY UNI-PAGES, PLATFORM: H5 || MP-WEIXIN
      {
        "pagePath": "pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的"
      },
      // #ifdef MP-WEIXIN
      {
        "pagePath": "pages/feed/index",
        "text": "动态"
      }
      // #endif
    ]
  }
}
